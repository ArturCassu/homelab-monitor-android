<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:baselineAligned="false"
    android:padding="12dp"
    android:background="@drawable/widget_preview_background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="CPU"
                android:src="@drawable/widget_preview_cpu_ring" />
            <TextView
                style="@style/WidgetPreviewValue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="18%"
                android:textStyle="bold" />
        </FrameLayout>
        <TextView
            style="@style/WidgetPreviewCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="CPU" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="RAM"
                android:src="@drawable/widget_preview_ram_ring" />
            <TextView
                style="@style/WidgetPreviewValue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="33%"
                android:textStyle="bold" />
        </FrameLayout>
        <TextView
            style="@style/WidgetPreviewCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="RAM" />
    </LinearLayout>
</LinearLayout>
