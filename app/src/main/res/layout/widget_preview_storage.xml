<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_preview_background">

    <TextView
        style="@style/WidgetPreviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Armazenamento" />

    <TextView
        style="@style/WidgetPreviewValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="/   64% usado" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_preview_track">
        <View
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_preview_primary" />
    </FrameLayout>

    <TextView
        style="@style/WidgetPreviewValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="/srv/docker   42% usado" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_preview_track">
        <View
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_preview_secondary" />
    </FrameLayout>
</LinearLayout>
