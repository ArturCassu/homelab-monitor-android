<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_preview_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_preview_dot_success" />
        <TextView
            style="@style/WidgetPreviewValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="ONLINE"
            android:textColor="@color/widget_preview_success"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/WidgetPreviewCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Sincronizado agora · Uptime 4d 7h" />
</LinearLayout>
