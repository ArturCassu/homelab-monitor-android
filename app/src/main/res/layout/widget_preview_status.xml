<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_preview_background">

    <TextView
        style="@style/WidgetPreviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:background="@drawable/widget_preview_pill">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_preview_dot_success" />

        <TextView
            style="@style/WidgetPreviewValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ONLINE"
            android:textColor="@color/widget_preview_success"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/WidgetPreviewCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Atualizado agora · Uptime 4d 7h" />
</LinearLayout>
